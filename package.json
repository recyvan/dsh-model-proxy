{
  "name": "dsh-model-proxy",
  "version": "0.2.0",
  "description": "Route DeepSeek Harness model API requests through a system, custom, or SOCKS proxy while every other request stays direct.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-model-proxy contributors",
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "proxy", "socks", "cordis", "openai", "anthropic"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recyvan/dsh-model-proxy.git"
  },
  "homepage": "https://github.com/recyvan/dsh-model-proxy",
  "bugs": {
    "url": "https://github.com/recyvan/dsh-model-proxy/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "README_zh.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5-0 <4.0.0",
    "undici": ">=6.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "undici": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "undici": "^7.28.0"
  }
}
